<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KaedePhi.Tool.App.Gui.ViewModels"
             xmlns:m="using:KaedePhi.Tool.App.Gui.Models"
             xmlns:loc="using:KaedePhi.Tool.Localization"
             x:Class="KaedePhi.Tool.App.Gui.Views.ToolPage"
             x:DataType="vm:ToolViewModel">

    <Grid Margin="34,26" RowDefinitions="*,Auto" RowSpacing="18">
        <Grid Grid.Row="0" ColumnDefinitions="310,*" ColumnSpacing="22">
            <Border Grid.Column="0" Classes="card" Padding="16">
                <Grid RowDefinitions="Auto,Auto,*">
                    <StackPanel Grid.Row="0" Spacing="4" Margin="4,2,4,16">
                        <TextBlock Text="{x:Static loc:GuiUiText.ui_tool_eyebrow}" Classes="eyebrow" />
                        <TextBlock Text="{x:Static loc:GuiUiText.ui_tool_page_title}" Classes="section-title" FontSize="19" />
                        <TextBlock Text="{x:Static loc:GuiUiText.ui_tool_page_desc}"
                                   Classes="muted" FontSize="12" />
                    </StackPanel>
                    <Border Grid.Row="1" Background="{DynamicResource AccentDimBrush}"
                            CornerRadius="0" Padding="11" Margin="0,0,0,12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <TextBlock Text="&#xf1c0;" Classes="fa-icon" FontSize="16"
                                       Foreground="{DynamicResource AccentBrush}" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{Binding CurrentFileName}" FontWeight="SemiBold"
                                           TextWrapping="Wrap" MaxHeight="36" />
                                <TextBlock Text="{Binding DetectedFormat}" Classes="muted" FontSize="11" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ListBox Grid.Row="2" ItemsSource="{Binding Tools}" SelectedItem="{Binding SelectedTool}"
                             SelectionMode="Single" Background="Transparent" BorderThickness="0"
                             Padding="0">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="CornerRadius" Value="10" />
                                <Setter Property="Padding" Value="12" />
                                <Setter Property="Margin" Value="0,0,0,8" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                            <Style Selector="ListBoxItem:pointerover">
                                <Setter Property="Background" Value="{DynamicResource SurfaceStrongBrush}" />
                            </Style>
                            <Style Selector="ListBoxItem:selected">
                                <Setter Property="Background" Value="{DynamicResource AccentDimBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentOutlineBrush}" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="m:ToolOption">
                                <Grid ColumnDefinitions="34,*" ColumnSpacing="10">
                                    <Border Width="32" Height="32" CornerRadius="9"
                                            Background="{DynamicResource SurfaceStrongBrush}">
                                        <TextBlock Text="{Binding IconGlyph}"
                                                   FontFamily="avares://KaedePhi.Tool.App/Assets/Fonts/fa-7-solid-900.otf#Font Awesome 7 Free"
                                                   FontWeight="Bold" FontSize="15"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}" Classes="muted" FontSize="11"
                                                   TextWrapping="Wrap" MaxHeight="32" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="1" Classes="card" Padding="22">
                <Grid RowDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Row="0" Spacing="4" Margin="0,2,0,18">
                        <TextBlock Text="{x:Static loc:GuiUiText.ui_tool_options_eyebrow}" Classes="eyebrow" />
                        <TextBlock Text="{x:Static loc:GuiLocalizationString.tool_options_title}" Classes="section-title" FontSize="19" />
                        <TextBlock Text="{x:Static loc:GuiUiText.ui_tool_options_desc}"
                                   Classes="muted" FontSize="12" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16" IsVisible="{Binding SelectedTool, Converter={x:Static ObjectConverters.IsNotNull}}">
                             <Border Background="{DynamicResource SurfaceStrongBrush}" CornerRadius="0" Padding="14">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <TextBlock Text="&#xf05a;" Classes="fa-icon" FontSize="16"
                                               Foreground="{DynamicResource AccentBrush}" />
                                    <TextBlock Grid.Column="1" Text="{x:Static loc:GuiUiText.ui_tool_file_tip}"
                                               Classes="muted" FontSize="12" TextWrapping="Wrap" />
                                </Grid>
                            </Border>

                            <Grid ColumnDefinitions="*,170" RowDefinitions="Auto,Auto,Auto" RowSpacing="12"
                                  IsVisible="{Binding ShowGeneralOptions}">
                                <StackPanel Grid.Row="0" Spacing="3" IsVisible="{Binding ShowPrecision}">
                                    <TextBlock Text="{x:Static loc:GuiLocalizationString.option_precision}" />
                                    <TextBlock Text="{x:Static loc:GuiUiText.ui_tool_precision_desc}" Classes="muted" FontSize="11" />
                                </StackPanel>
                                <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding Precision}"
                                               Minimum="1" Maximum="4096" Increment="1" FormatString="F0"
                                               IsVisible="{Binding ShowPrecision}" />
                                <StackPanel Grid.Row="1" Spacing="3" IsVisible="{Binding ShowTolerance}">
                                    <TextBlock Text="{x:Static loc:GuiLocalizationString.option_tolerance}" />
                                    <TextBlock Text="{x:Static loc:GuiUiText.ui_tool_tolerance_desc}" Classes="muted" FontSize="11" />
                                </StackPanel>
                                <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Tolerance}"
                                               Minimum="0" Maximum="100" Increment="0.1" FormatString="F2"
                                               IsVisible="{Binding ShowTolerance}" />
                                <StackPanel Grid.Row="2" Spacing="3" IsVisible="{Binding ShowMergeTolerance}">
                                    <TextBlock Text="{x:Static loc:GuiLocalizationString.option_unbind_merge_tolerance}" />
                                    <TextBlock Text="{x:Static loc:GuiUiText.ui_tool_merge_tolerance_desc}" Classes="muted" FontSize="11" />
                                </StackPanel>
                                <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding MergeTolerance}"
                                               Minimum="0" Maximum="100" Increment="0.1" FormatString="F2"
                                               IsVisible="{Binding ShowMergeTolerance}" />
                            </Grid>

                            <StackPanel Spacing="9" IsVisible="{Binding ShowGeneralOptions}">
                                <CheckBox IsVisible="{Binding ShowClassicMode}"
                                          Content="{x:Static loc:GuiLocalizationString.option_classic_mode}"
                                          IsChecked="{Binding ClassicMode}" />
                                <CheckBox IsVisible="{Binding ShowDisableCompress}"
                                          IsEnabled="{Binding DisableCompressEnabled}"
                                          Content="{x:Static loc:GuiLocalizationString.option_disable_compress}"
                                          IsChecked="{Binding DisableCompress}"
                                          ToolTip.Tip="{x:Static loc:GuiLocalizationString.option_disable_compress_hint}" />
                            </StackPanel>

                            <StackPanel IsVisible="{Binding ShowRenderOptions}" Spacing="14">
                                <Border Height="1" Background="{DynamicResource DividerBrush}" />
                                <TextBlock Text="{x:Static loc:GuiUiText.ui_tool_render_title}" Classes="section-title" />
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="12">
                                    <StackPanel Grid.Row="0" Spacing="3">
                                        <TextBlock Text="{x:Static loc:GuiLocalizationString.option_pixels_per_beat}" />
                                        <NumericUpDown Value="{Binding PixelsPerBeat}" Minimum="10" Maximum="1000"
                                                       Increment="10" FormatString="F0" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="3">
                                        <TextBlock Text="{x:Static loc:GuiLocalizationString.option_channel_width}" />
                                        <NumericUpDown Value="{Binding ChannelWidth}" Minimum="50" Maximum="1000"
                                                       Increment="10" FormatString="F0" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Spacing="3">
                                        <TextBlock Text="{x:Static loc:GuiLocalizationString.option_samples_per_event}" />
                                        <NumericUpDown Value="{Binding SamplesPerEvent}" Minimum="4" Maximum="1024"
                                                       Increment="4" FormatString="F0" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="3">
                                        <TextBlock Text="{x:Static loc:GuiLocalizationString.option_beat_subdivisions}" />
                                        <NumericUpDown Value="{Binding BeatSubdivisions}" Minimum="1" Maximum="16"
                                                       Increment="1" FormatString="F0" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Spacing="5">
                                    <TextBlock Text="{x:Static loc:GuiLocalizationString.option_render_output_dir}" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBox Grid.Column="0" Text="{Binding RenderOutputDir}"
                                                 Watermark="{x:Static loc:GuiLocalizationString.option_render_output_dir_hint}" />
                                        <Button Grid.Column="1" Classes="secondary" Content="{x:Static loc:GuiLocalizationString.btn_browse}"
                                                Click="OnBrowseOutputDirClick" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Background="{DynamicResource WarningBannerBackground}"
                            BorderBrush="{DynamicResource WarningBannerBorder}" BorderThickness="1"
                             CornerRadius="0" Padding="12" Margin="0,16,0,0"
                            IsVisible="{Binding HasUnclearContent}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <TextBlock Text="&#xf071;" Classes="fa-icon" FontSize="15"
                                       Foreground="{DynamicResource WarningBannerForeground}" />
                            <TextBlock Grid.Column="1" Text="{x:Static loc:GuiLocalizationString.tool_unclear_content_warning}"
                                       FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource WarningBannerForeground}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
            <TextBlock Text="{Binding StatusText}" Classes="muted" FontSize="12"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <Button Classes="ghost" Click="OnReturnClick" IsEnabled="{Binding !IsProcessing}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock Text="&#xf060;" Classes="fa-icon" FontSize="12" />
                        <TextBlock Text="{x:Static loc:GuiLocalizationString.btn_back_to_import}" />
                    </StackPanel>
                </Button>
                <Button Classes="secondary" Click="OnExportClick" IsEnabled="{Binding !IsProcessing}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock Text="&#xf56e;" Classes="fa-icon" FontSize="13" />
                        <TextBlock Text="{x:Static loc:GuiLocalizationString.btn_export_chart}" />
                    </StackPanel>
                </Button>
                <Button Classes="primary" Click="OnRunClick" IsEnabled="{Binding CanRun}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="&#xf04b;" Classes="fa-icon" FontSize="12" />
                        <TextBlock Text="{x:Static loc:GuiLocalizationString.btn_run_tool}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
