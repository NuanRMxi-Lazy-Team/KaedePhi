<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KaedePhi.Tool.App.Gui.ViewModels"
             xmlns:loc="using:KaedePhi.Tool.Localization"
             x:Class="KaedePhi.Tool.App.Gui.Views.ImportOptionsPage"
             x:DataType="vm:ImportOptionsViewModel">

    <Grid Margin="34,30">
        <Grid IsVisible="{Binding !IsLoading}" ColumnDefinitions="300,*" ColumnSpacing="24">
            <StackPanel Grid.Column="0" Spacing="14">
                <Border Classes="card" Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="{x:Static loc:GuiUiText.ui_options_eyebrow}" Classes="eyebrow" />
                        <TextBlock Text="{x:Static loc:GuiUiText.ui_options_summary_title}" Classes="page-title" FontSize="27" />
                        <TextBlock Text="{x:Static loc:GuiUiText.ui_options_summary_desc}"
                                   Classes="muted" FontSize="12" TextWrapping="Wrap" />
                        <Border Background="{DynamicResource AccentDimBrush}" CornerRadius="0" Padding="12">
                            <StackPanel Spacing="5">
                                <TextBlock Text="{x:Static loc:GuiUiText.ui_options_detected_format}" Classes="muted" FontSize="11" />
                                <TextBlock Text="{Binding FormatName}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
                <Border Classes="card" Padding="20">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Static loc:GuiUiText.ui_options_file}" Classes="muted" FontSize="11" />
                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Static loc:GuiUiText.ui_options_detected_ready}" Classes="muted" FontSize="11" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">
                <StackPanel Grid.Row="0" Spacing="5" Margin="0,2,0,18">
                    <TextBlock Text="{x:Static loc:GuiLocalizationString.import_options_title}" Classes="section-title" />
                    <TextBlock Text="{x:Static loc:GuiUiText.ui_options_hint}"
                               Classes="muted" FontSize="12" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Border Classes="card" Padding="22">
                        <StackPanel Spacing="18">
                            <StackPanel IsVisible="{Binding ShowPeOptions}" Spacing="13">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{x:Static loc:GuiUiText.ui_import_pe_title}" Classes="section-title" />
                                    <TextBlock Text="{x:Static loc:GuiUiText.ui_import_pe_desc}"
                                               Classes="muted" FontSize="12" />
                                </StackPanel>
                                <Grid ColumnDefinitions="*,180" RowDefinitions="Auto,Auto" RowSpacing="12">
                                    <StackPanel Grid.Row="0" Spacing="3">
                                        <TextBlock Text="{x:Static loc:GuiUiText.ui_import_frame_duration}" />
                                        <TextBlock Text="{x:Static loc:GuiUiText.ui_import_frame_duration_desc}" Classes="muted" FontSize="11" />
                                    </StackPanel>
                                    <NumericUpDown Grid.Row="0" Grid.Column="1"
                                                   Value="{Binding PeFrameDurationBeat}" Minimum="1" Maximum="4096"
                                                   Increment="1" FormatString="F0" />
                                    <StackPanel Grid.Row="1" Spacing="3">
                                        <TextBlock Text="{x:Static loc:GuiUiText.ui_import_trailing_padding}" />
                                        <TextBlock Text="{x:Static loc:GuiUiText.ui_import_trailing_padding_desc}" Classes="muted" FontSize="11" />
                                    </StackPanel>
                                    <NumericUpDown Grid.Row="1" Grid.Column="1"
                                                   Value="{Binding PeTrailingBeatPadding}" Minimum="1" Maximum="4096"
                                                   Increment="1" FormatString="F0" />
                                </Grid>
                            </StackPanel>

                            <StackPanel IsVisible="{Binding ShowPhiChainOptions}" Spacing="13">
                                <StackPanel Spacing="3">
                                <TextBlock Text="{x:Static loc:GuiUiText.ui_import_phichain_title}" Classes="section-title" />
                                <TextBlock Text="{x:Static loc:GuiUiText.ui_import_phichain_desc}"
                                               Classes="muted" FontSize="12" />
                                </StackPanel>
                                <Grid ColumnDefinitions="*,180">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{x:Static loc:GuiLocalizationString.convert_easing_precision}" />
                                        <TextBlock Text="{x:Static loc:GuiUiText.ui_recommended_64}" Classes="muted" FontSize="11" />
                                    </StackPanel>
                                    <NumericUpDown Grid.Column="1"
                                                   Value="{Binding PhiChainUnsupportedEasingPrecision}" Minimum="1"
                                                   Maximum="4096" Increment="1" FormatString="F0" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                            Spacing="10" Margin="0,20,0,0">
                    <Button Classes="ghost" Click="OnCancelClick"
                            Content="{x:Static loc:GuiLocalizationString.btn_back}" />
                    <Button Classes="primary" Click="OnConfirmClick" Padding="20,10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="&#xf058;" Classes="fa-icon" FontSize="14" />
                            <TextBlock Text="{x:Static loc:GuiLocalizationString.import_options_confirm}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <Border Background="{DynamicResource OverlayBrush}" IsVisible="{Binding IsLoading}" ZIndex="100">
            <Border Classes="card" Padding="32" MinWidth="320"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <ProgressBar Value="{Binding Progress.Value}" Maximum="100"
                                 IsIndeterminate="{Binding Progress.IsIndeterminate}" Height="6" />
                    <TextBlock Text="{x:Static loc:GuiLocalizationString.import_loading}"
                               FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Progress.PercentageText}"
                               IsVisible="{Binding Progress.IsDeterminate}" Classes="muted"
                               FontSize="12" HorizontalAlignment="Center" />
                    <Button Classes="secondary" Content="{x:Static loc:GuiLocalizationString.btn_cancel}"
                            Click="OnCancelImportClick" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
