<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KaedePhi.Tool.App.Gui.ViewModels"
             xmlns:loc="using:KaedePhi.Tool.Localization"
             x:Class="KaedePhi.Tool.App.Gui.Views.ImportPage"
             x:DataType="vm:ImportViewModel"
             DragDrop.AllowDrop="True"
             Background="Transparent">

    <Grid>
        <!-- 主内容（拖拽时模糊） -->
        <Grid Name="ContentGrid">
            <!-- 居中导入按钮 -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20"
                        IsVisible="{Binding !IsLoading}">
                <Image Source="avares://KaedePhi.Tool.App/Assets/KaedePhiIcon.png"
                       Width="120" Height="120"
                       HorizontalAlignment="Center" />
                <TextBlock Text="{x:Static loc:GuiLocalizationString.app_title}"
                           FontSize="36" FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource SystemAccentColor}" />
                <TextBlock Text="{x:Static loc:GuiLocalizationString.app_subtitle}"
                           FontSize="14" Opacity="0.6"
                           HorizontalAlignment="Center" />
                <Button Classes="accent"
                        HorizontalAlignment="Center"
                        Padding="40,16"
                        FontSize="16"
                        Click="OnImportClick">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="&#xf07c;" Classes="fa-icon" FontSize="20" />
                        <TextBlock Text="{x:Static loc:GuiLocalizationString.import_button}" />
                    </StackPanel>
                </Button>
                <TextBlock Text="{x:Static loc:GuiLocalizationString.import_drop_hint}"
                           FontSize="12" Opacity="0.4"
                           HorizontalAlignment="Center"
                           IsVisible="{Binding !IsLoading}" />
            </StackPanel>

            <!-- 加载覆盖层 -->
            <Border Background="#80000000"
                    IsVisible="{Binding IsLoading}"
                    ZIndex="100">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                    <TextBlock Text="&#xf110;" Classes="fa-icon" FontSize="48"
                               Foreground="{DynamicResource SystemAccentColor}"
                               HorizontalAlignment="Center">
                        <TextBlock.Styles>
                            <Style Selector="TextBlock">
                                <Style.Animations>
                                    <Animation Duration="0:0:1" IterationCount="Infinite">
                                        <KeyFrame Cue="0%">
                                            <Setter Property="RotateTransform.Angle" Value="0" />
                                        </KeyFrame>
                                        <KeyFrame Cue="100%">
                                            <Setter Property="RotateTransform.Angle" Value="360" />
                                        </KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>
                        </TextBlock.Styles>
                    </TextBlock>
                    <TextBlock Text="{x:Static loc:GuiLocalizationString.import_loading}"
                               FontSize="16" Foreground="White"
                               HorizontalAlignment="Center" />
                    <Button Content="{x:Static loc:GuiLocalizationString.btn_cancel}"
                            HorizontalAlignment="Center"
                            Click="OnCancelLoadingClick" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Drop 覆盖层：深色半透明背景 + 虚线边框，完全遮挡后方内容 -->
        <Border Name="DropOverlay"
                Background="#E6101020"
                IsVisible="False"
                ZIndex="200">
            <Border BorderBrush="{DynamicResource SystemAccentColor}"
                    BorderThickness="3"
                    CornerRadius="16"
                    Margin="24">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                    <TextBlock Text="&#xf019;" Classes="fa-icon" FontSize="56"
                               Foreground="{DynamicResource SystemAccentColor}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{x:Static loc:GuiLocalizationString.import_drop_active}"
                               FontSize="20" FontWeight="SemiBold"
                               Foreground="White"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Border>

        <!-- 右下角流式复选框 -->
        <CheckBox Content="{x:Static loc:GuiLocalizationString.import_stream_loading}"
                  IsChecked="{Binding UseStream}"
                  IsVisible="{Binding !IsLoading}"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Margin="24"
                  ZIndex="10" />
    </Grid>
</UserControl>