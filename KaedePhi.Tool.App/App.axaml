<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KaedePhi.Tool.App.Gui.ViewModels"
             xmlns:views="using:KaedePhi.Tool.App.Gui.Views"
             x:Class="KaedePhi.Tool.App.App"
             RequestedThemeVariant="Dark">

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="#BD3F69" />
                <ColorPaletteResources x:Key="Dark" Accent="#FF8FB5" />
            </FluentTheme.Palettes>
        </FluentTheme>

        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="Inter" />
        </Style>

        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="Inter" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <Style Selector="TextBlock.eyebrow">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="1.2" />
        </Style>
        <Style Selector="TextBlock.page-header">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.page-title">
            <Setter Property="FontSize" Value="32" />
            <Setter Property="FontWeight" Value="ExtraBold" />
        </Style>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.step-number">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.nav-item">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0,6" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.nav-item:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.nav-item.active">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.nav-item TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <Style Selector="Button.nav-item.active TextBlock, Button.nav-item:pointerover TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.nav-item:disabled">
            <Setter Property="Opacity" Value="0.42" />
        </Style>
        <Style Selector="Button.nav-item.collapsed">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.nav-item TextBlock.nav-description">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentStrongBrush}" />
        </Style>
        <Style Selector="Button.primary TextBlock, Button.import-action TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        </Style>
        <Style
            Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.import-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentStrongBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        </Style>
        <Style
            Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.import-action:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Border.context-card">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style Selector="Border.status-pill">
            <Setter Property="Background" Value="{DynamicResource AccentDimBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentOutlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinHeight" Value="32" />
        </Style>
        <Style Selector="TextBox, ComboBox, NumericUpDown">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="NumericUpDown /template/ ButtonSpinner /template/ Border">
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style
            Selector="NumericUpDown /template/ ButtonSpinner /template/ RepeatButton#PART_DecreaseButton /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Button.import-action">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="22,11" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Button.import-action:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentStrongBrush}" />
        </Style>
        <Style Selector="Expander">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style Selector="TextBlock.fa-icon">
            <Setter Property="FontFamily"
                    Value="avares://KaedePhi.Tool.App/Assets/Fonts/fa-solid-900.ttf#Font Awesome 6 Free" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.sidebar-toggle">
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}">
                        <Border x:Name="PART_SidebarGrip" Width="2" Height="32" CornerRadius="1"
                                Background="{DynamicResource DividerBrush}" Opacity="0.6"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.sidebar-toggle:pointerover, Button.sidebar-toggle:focus-visible">
            <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
        </Style>
        <Style Selector="Button.sidebar-toggle:pressed">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        </Style>
        <Style
            Selector="Button.sidebar-toggle:pointerover /template/ Border#PART_SidebarGrip, Button.sidebar-toggle:focus-visible /template/ Border#PART_SidebarGrip">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.nav-item:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        </Style>
        <Style Selector="Button.background-refresh">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="Button.background-refresh:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Button.background-refresh.busy TextBlock">
            <Style.Animations>
                <Animation Duration="0:0:1" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Border.note">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Border.section-header">
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,0,0,18" />
        </Style>
        <Style Selector="ProgressBar">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#171419" />
            <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#EB231D26" />
            <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#E8231D26" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#F2231D26" />
            <SolidColorBrush x:Key="SurfaceStrongBrush" Color="#FF302630" />
            <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FF231D26" />
            <SolidColorBrush x:Key="DividerBrush" Color="#38FFF3F8" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFF3F8" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFCBBDC6" />
            <SolidColorBrush x:Key="AccentBrush" Color="#FFFF8FB5" />
            <SolidColorBrush x:Key="AccentStrongBrush" Color="#FFFFB4CD" />
            <SolidColorBrush x:Key="AccentDimBrush" Color="#FF6B374E" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#FF6B374E" />
            <SolidColorBrush x:Key="AccentOutlineBrush" Color="#FFB96A89" />
            <SolidColorBrush x:Key="OnAccentBrush" Color="#FF231D26" />
            <SolidColorBrush x:Key="SceneVeilBrush" Color="#B8171419" />
            <SolidColorBrush x:Key="OverlayBrush" Color="#D9171419" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#FF74C7AA" />
            <SolidColorBrush x:Key="WarningBrush" Color="#FFE9CA65" />
            <SolidColorBrush x:Key="DangerBrush" Color="#FFFF9CA8" />
            <SolidColorBrush x:Key="DangerDimBrush" Color="#FF422D35" />
            <SolidColorBrush x:Key="CoolBrush" Color="#FF78B5DF" />
            <SolidColorBrush x:Key="VersionLabelForeground" Color="#FFCBBDC6" />
            <SolidColorBrush x:Key="WarningBannerBackground" Color="#FF483B22" />
            <SolidColorBrush x:Key="WarningBannerBorder" Color="#FF9C813B" />
            <SolidColorBrush x:Key="WarningBannerForeground" Color="#FFFFE08A" />
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F4ECDF" />
                    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#E6FFF8EB" />
                    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#E6FFF8EB" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#F2FFF8EB" />
                    <SolidColorBrush x:Key="SurfaceStrongBrush" Color="#FFFFF8EB" />
                    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFF8EB" />
                    <SolidColorBrush x:Key="DividerBrush" Color="#38302A31" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF302A31" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF756A73" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#FFBD3F69" />
                    <SolidColorBrush x:Key="AccentStrongBrush" Color="#FFA92E58" />
                    <SolidColorBrush x:Key="AccentDimBrush" Color="#FFFFC3D6" />
                    <SolidColorBrush x:Key="AccentSoftBrush" Color="#FFFFC3D6" />
                    <SolidColorBrush x:Key="AccentOutlineBrush" Color="#FFD77A99" />
                    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFF8EB" />
                    <SolidColorBrush x:Key="SceneVeilBrush" Color="#BFF4ECDF" />
                    <SolidColorBrush x:Key="OverlayBrush" Color="#D9F4ECDF" />
                    <SolidColorBrush x:Key="SuccessBrush" Color="#FF24765F" />
                    <SolidColorBrush x:Key="WarningBrush" Color="#FF8A6500" />
                    <SolidColorBrush x:Key="DangerBrush" Color="#FFB13F4F" />
                    <SolidColorBrush x:Key="DangerDimBrush" Color="#FFFFE7E6" />
                    <SolidColorBrush x:Key="CoolBrush" Color="#FF4E86AD" />
                    <SolidColorBrush x:Key="VersionLabelForeground" Color="#FF756A73" />
                    <SolidColorBrush x:Key="WarningBannerBackground" Color="#FFF4CE" />
                    <SolidColorBrush x:Key="WarningBannerBorder" Color="#F0C36D" />
                    <SolidColorBrush x:Key="WarningBannerForeground" Color="#7A5900" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#171419" />
                    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#EB231D26" />
                    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#E8231D26" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#F2231D26" />
                    <SolidColorBrush x:Key="SurfaceStrongBrush" Color="#FF302630" />
                    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FF231D26" />
                    <SolidColorBrush x:Key="DividerBrush" Color="#38FFF3F8" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFF3F8" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFCBBDC6" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#FFFF8FB5" />
                    <SolidColorBrush x:Key="AccentStrongBrush" Color="#FFFFB4CD" />
                    <SolidColorBrush x:Key="AccentDimBrush" Color="#FF6B374E" />
                    <SolidColorBrush x:Key="AccentSoftBrush" Color="#FF6B374E" />
                    <SolidColorBrush x:Key="AccentOutlineBrush" Color="#FFB96A89" />
                    <SolidColorBrush x:Key="OnAccentBrush" Color="#FF231D26" />
                    <SolidColorBrush x:Key="SceneVeilBrush" Color="#B8171419" />
                    <SolidColorBrush x:Key="OverlayBrush" Color="#D9171419" />
                    <SolidColorBrush x:Key="SuccessBrush" Color="#FF74C7AA" />
                    <SolidColorBrush x:Key="WarningBrush" Color="#FFE9CA65" />
                    <SolidColorBrush x:Key="DangerBrush" Color="#FFFF9CA8" />
                    <SolidColorBrush x:Key="DangerDimBrush" Color="#FF422D35" />
                    <SolidColorBrush x:Key="CoolBrush" Color="#FF78B5DF" />
                    <SolidColorBrush x:Key="VersionLabelForeground" Color="#FFCBBDC6" />
                    <SolidColorBrush x:Key="WarningBannerBackground" Color="#FF483B22" />
                    <SolidColorBrush x:Key="WarningBannerBorder" Color="#FF9C813B" />
                    <SolidColorBrush x:Key="WarningBannerForeground" Color="#FFFFE08A" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <DataTemplate DataType="vm:ImportViewModel">
            <views:ImportPage />
        </DataTemplate>
        <DataTemplate DataType="vm:ImportOptionsViewModel">
            <views:ImportOptionsPage />
        </DataTemplate>
        <DataTemplate DataType="vm:ToolViewModel">
            <views:ToolPage />
        </DataTemplate>
        <DataTemplate DataType="vm:ExportViewModel">
            <views:ExportPage />
        </DataTemplate>
        <DataTemplate DataType="vm:ProcessingViewModel">
            <views:ProcessingPage />
        </DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel">
            <views:SettingsPage />
        </DataTemplate>
    </Application.DataTemplates>
</Application>
