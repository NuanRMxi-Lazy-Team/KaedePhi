<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Configurations>Debug;Release;PreRelease</Configurations>
    <Platforms>x64</Platforms>
    <AssemblyName>KaedePhi.Tool</AssemblyName>
    <RootNamespace>KaedePhi.Tool</RootNamespace>
    <Title>KaedePhi Tool Lib</Title>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Description>我知晓，那无边的旅途。</Description>
    <Copyright>NuanR_Star Ciallo Copyright © 2026</Copyright>
    <PackageProjectUrl>https://github.com/NuanRMxi-Lazy-Team/KaedePhi</PackageProjectUrl>
    <PackageIcon>KaedePhiIcon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/NuanRMxi-Lazy-Team/KaedePhi</RepositoryUrl>
    <PackageLicenseExpression>LGPL-3.0-only</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <Authors>NuanR_Star Ciallo Team</Authors>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\KaedePhiIcon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KaedePhi.Core\KaedePhi.Core.csproj" />
    <ProjectReference Include="..\KaedePhi.Tool.Analyzers\KaedePhi.Tool.Analyzers\KaedePhi.Tool.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\KaedePhi.Core.Analyzers\KaedePhi.Core.Analyzers\KaedePhi.Core.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.153.1" />
  </ItemGroup>
</Project>
